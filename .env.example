ENVIRONMENT=development
DEPLOYMENT_MODE=single_server
SECRET_KEY=replace-with-a-long-random-private-string
DB_HOST=127.0.0.1
DB_PORT=3306
# Optional absolute path when MySQL's bin folder is not included in Windows PATH.
MYSQLDUMP_PATH=C:\Program Files\MySQL\MySQL Server 8.0\bin\mysqldump.exe
DB_NAME=slurry_management
DB_USER=slurry_app
DB_PASSWORD=replace-me
IMPORT_SCHEMA=system_import
# Each department has its own application database and operational import schema.
# Put real overrides in the private .env.departments file, never in source control.
SLITTING_DB_NAME=slitting_management
SLITTING_IMPORT_SCHEMA=slitting_system_import
SLITTING_DB_USER=slitting_app
SLITTING_DB_PASSWORD=replace-me
# Public HTTPS base used in newly printed inventory QR codes. Do not add a
# trailing slash. Existing QR labels keep the URL already encoded in them.
QR_PUBLIC_BASE_URL=https://slurry-management.local
# Use a separate MySQL account with backup-only privileges for scheduled backups.
DB_BACKUP_USER=slurry_backup
DB_BACKUP_PASSWORD=replace-me
# Optional Slitting-specific backup account. When omitted, the shared backup
# account above is used for both department schemas.
SLITTING_DB_BACKUP_USER=
SLITTING_DB_BACKUP_PASSWORD=
# Pilot/manual default. Use a BitLocker-encrypted data drive later if needed.
BACKUP_DIRECTORY=C:\GNEM_Backups
BACKUP_RETENTION_DAYS=30
WEB_HOST=127.0.0.1
WEB_PORT=5000
ALLOWED_HOSTS=localhost,127.0.0.1
# Separate direct HTTP listener for read-only factory displays. It cannot serve
# employee, manager, login, or write routes and does not depend on Caddy.
DISPLAY_HTTP_HOST=172.23.19.139
DISPLAY_HTTP_PORT=5000
# Production: HTTPS for the main application must be provided by Caddy.
BEHIND_TLS_PROXY=false
# Leave DB_HOST local in the one always-on server design. Do not expose MySQL
# to employee devices; Power BI receives its own read-only MySQL account.
# Optional if MySQL is later moved to a separate computer.
# DB_SSL_CA=C:\\path\\to\\mysql-ca.pem
# DB_SSL_VERIFY_CERT=true
LOW_YIELD_THRESHOLD=0.90
DB_POOL_SIZE=12
# Recent records are returned in pages, preventing large history pages from slowing browsers.
RECORDS_PAGE_SIZE=50
RECORDS_MAX_PAGE_SIZE=100
SYNC_BATCH_LIMIT=100
MANAGER_LOGIN_MAX_ATTEMPTS=5
MANAGER_LOGIN_WINDOW_SECONDS=300
MANAGER_PIN=replace-with-a-long-manager-pin
# Future AI placeholder. Leave AI_ENABLED=false until you implement and review a
# manager-only server-side service. Never put AI_API_KEY in browser JavaScript.
AI_ENABLED=false
AI_PROVIDER=
AI_API_BASE_URL=
AI_MODEL=
AI_API_KEY=
