# Factory server only. Put actual values in its private .env file, never Git.
ENVIRONMENT=production
DEPLOYMENT_MODE=single_server
SECRET_KEY=long-unique-production-secret
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=slurry_management
DB_USER=slurry_web_app
DB_PASSWORD=long-unique-production-password
WEB_HOST=127.0.0.1
WEB_PORT=5000
ALLOWED_HOSTS=slurry-factory.local,FACTORY_SERVER_IP
BEHIND_TLS_PROXY=true
MANAGER_PIN=long-unique-production-manager-pin
LOW_YIELD_THRESHOLD=0.90
