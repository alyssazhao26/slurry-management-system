# Isolated test/staging environment. Never point this file at production MySQL.
ENVIRONMENT=production
DEPLOYMENT_MODE=single_server
SECRET_KEY=unique-test-environment-secret
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=slurry_management_test
DB_USER=slurry_test_app
DB_PASSWORD=unique-test-password
WEB_HOST=127.0.0.1
WEB_PORT=5000
ALLOWED_HOSTS=slurry-test.local,TEST_SERVER_IP
BEHIND_TLS_PROXY=true
MANAGER_PIN=unique-test-manager-pin
LOW_YIELD_THRESHOLD=0.90
