-- Run this once in MySQL Workbench as a MySQL administrator on the production server.
-- Replace every ALL_CAPS placeholder before running. Do not save the completed file in Git.

CREATE DATABASE IF NOT EXISTS slurry_management CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci;
CREATE DATABASE IF NOT EXISTS system_import CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci;
CREATE DATABASE IF NOT EXISTS slitting_management CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci;
CREATE DATABASE IF NOT EXISTS slitting_system_import CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci;

CREATE USER IF NOT EXISTS 'slurry_web_app'@'localhost' IDENTIFIED BY 'WEB_APP_LONG_RANDOM_PASSWORD';
GRANT SELECT, INSERT, UPDATE ON slurry_management.* TO 'slurry_web_app'@'localhost';
GRANT SELECT, INSERT, UPDATE ON system_import.* TO 'slurry_web_app'@'localhost';

CREATE USER IF NOT EXISTS 'slitting_web_app'@'localhost' IDENTIFIED BY 'SLITTING_WEB_APP_LONG_RANDOM_PASSWORD';
GRANT SELECT, INSERT, UPDATE ON slitting_management.* TO 'slitting_web_app'@'localhost';
GRANT SELECT, INSERT, UPDATE ON slitting_system_import.* TO 'slitting_web_app'@'localhost';

-- Replace POWERBI_GATEWAY_IP with the one approved Power BI gateway/manager computer IP.
CREATE USER IF NOT EXISTS 'slurry_powerbi'@'POWERBI_GATEWAY_IP' IDENTIFIED BY 'POWERBI_LONG_RANDOM_PASSWORD';
GRANT SELECT ON system_import.* TO 'slurry_powerbi'@'POWERBI_GATEWAY_IP';

-- Slitting Power BI reader. Use the fixed IP of the new approved Power BI computer
-- or standard-mode gateway computer; never use '%' as the host.
CREATE USER IF NOT EXISTS 'slitting_powerbi'@'SLITTING_POWERBI_COMPUTER_IP' IDENTIFIED BY 'SLITTING_POWERBI_LONG_RANDOM_PASSWORD';
GRANT SELECT ON slitting_system_import.* TO 'slitting_powerbi'@'SLITTING_POWERBI_COMPUTER_IP';

-- Backup-only account used by scripts\backup_factory_database.ps1.
CREATE USER IF NOT EXISTS 'slurry_backup'@'localhost' IDENTIFIED BY 'BACKUP_LONG_RANDOM_PASSWORD';
GRANT SELECT, SHOW VIEW, TRIGGER, EVENT ON slurry_management.* TO 'slurry_backup'@'localhost';
GRANT SELECT, SHOW VIEW, TRIGGER, EVENT ON system_import.* TO 'slurry_backup'@'localhost';
GRANT SELECT, SHOW VIEW, TRIGGER, EVENT ON slitting_management.* TO 'slurry_backup'@'localhost';
GRANT SELECT, SHOW VIEW, TRIGGER, EVENT ON slitting_system_import.* TO 'slurry_backup'@'localhost';

-- Future manager-only AI service. Create only when AI code is deployed.
-- Replace AI_SERVICE_IP with the manager/AI computer's fixed IP.
CREATE USER IF NOT EXISTS 'slurry_ai'@'AI_SERVICE_IP' IDENTIFIED BY 'AI_READ_ONLY_LONG_RANDOM_PASSWORD';
GRANT SELECT ON system_import.* TO 'slurry_ai'@'AI_SERVICE_IP';

-- Permanent migration-only account. It is schema-scoped and is never used by
-- the running website. Keep its password only in the private .env.departments.
CREATE USER IF NOT EXISTS 'gnem_migrator'@'localhost' IDENTIFIED BY 'MIGRATOR_LONG_RANDOM_PASSWORD';
GRANT SELECT, INSERT, UPDATE, DELETE, CREATE, ALTER, DROP, INDEX, REFERENCES ON slurry_management.* TO 'gnem_migrator'@'localhost';
GRANT SELECT, INSERT, UPDATE, DELETE, CREATE, ALTER, DROP, INDEX, REFERENCES ON system_import.* TO 'gnem_migrator'@'localhost';
GRANT SELECT, INSERT, UPDATE, DELETE, CREATE, ALTER, DROP, INDEX, REFERENCES ON slitting_management.* TO 'gnem_migrator'@'localhost';
GRANT SELECT, INSERT, UPDATE, DELETE, CREATE, ALTER, DROP, INDEX, REFERENCES ON slitting_system_import.* TO 'gnem_migrator'@'localhost';

FLUSH PRIVILEGES;

-- Do not use gnem_migrator as DB_USER or SLITTING_DB_USER.
